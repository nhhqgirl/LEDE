#
# Target System
#
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

#
# Firmware Size
#
CONFIG_TARGET_KERNEL_PARTSIZE=64
CONFIG_TARGET_ROOTFS_PARTSIZE=960

#
# Build
#
# CONFIG_CCACHE is not set
# CONFIG_DEVEL is not set

#
# ESXi BIOS / GRUB / SquashFS
#
CONFIG_GRUB_IMAGES=y
# CONFIG_GRUB_EFI_IMAGES is not set
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 不生成额外 rootfs 格式
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_VMDK_IMAGES is not set
# CONFIG_QCOW2_IMAGES is not set
# CONFIG_VHDX_IMAGES is not set

#
# ESXi / Physical NIC
#
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-vmw_pvscsi=y
CONFIG_PACKAGE_open-vm-tools=y

#
# LuCI / Basic Applications
#
CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_luci-app-diskman=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-onliner=y
CONFIG_PACKAGE_luci-app-samba4=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-wol=y

#
# nlbwmon
#
CONFIG_PACKAGE_nlbwmon=y
CONFIG_PACKAGE_luci-app-nlbwmon=y

#
# =========================================================
# OpenClash Meta / TUN / fw4 / nftables
# =========================================================
#

# Shell / download / JSON
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_jq=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y

# CA / SSL
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y
CONFIG_PACKAGE_libustream-openssl=y
CONFIG_PACKAGE_libopenssl=y
CONFIG_PACKAGE_libcurl=y

# dnsmasq-full
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq_full_ipset=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y

# iproute2
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_ip-bridge=y
CONFIG_PACKAGE_ipset=y

# nftables / fw4
CONFIG_PACKAGE_nftables=y

# iptables-nft compatibility layer
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_iptables-mod-extra=y
CONFIG_PACKAGE_iptables-mod-tproxy=y

# TUN
CONFIG_PACKAGE_kmod-tun=y

# nft TPROXY
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
CONFIG_PACKAGE_kmod-nfnetlink=y

# nft core / NAT
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-fib=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-nat6=y

# Conntrack
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y

# Connection mark / policy routing support
CONFIG_PACKAGE_kmod-connmark=y

# Network diagnostics
CONFIG_PACKAGE_kmod-inet-diag=y

# OpenClash Meta runtime
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_luci-compat=y

# Capabilities
CONFIG_PACKAGE_libcap=y
CONFIG_PACKAGE_libcap-bin=y

#
# =========================================================
# PPPoE / 1Gbps
# =========================================================
#

CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y

CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y

#
# =========================================================
# TCP Performance / BBR / FQ
# =========================================================
#

CONFIG_PACKAGE_kmod-tcp-bbr=y
CONFIG_PACKAGE_kmod-sched-fq=y

CONFIG_PACKAGE_tc=y
CONFIG_PACKAGE_ss=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_irqbalance=y

# Network testing
CONFIG_PACKAGE_kmod-netem=y
CONFIG_PACKAGE_iperf3=y

#
# TUN 模式下关闭硬件/流量卸载
#
# CONFIG_PACKAGE_kmod-nft-offload is not set
# CONFIG_PACKAGE_kmod-flow-offload is not set

#
# =========================================================
# Samba4
# =========================================================
#

CONFIG_PACKAGE_samba4-server=y
CONFIG_PACKAGE_wsdd2=y

#
# =========================================================
# IPv6
# =========================================================
#

CONFIG_PACKAGE_6in4=y
CONFIG_PACKAGE_ipv6helper=y

CONFIG_PACKAGE_ip6tables=y
CONFIG_PACKAGE_ip6tables-extra=y

CONFIG_PACKAGE_odhcp6c=y
CONFIG_PACKAGE_odhcpd-ipv6only=y

CONFIG_PACKAGE_kmod-ip6tables=y
CONFIG_PACKAGE_kmod-nf-nat6=y

#
# =========================================================
# Disk / GPT
# =========================================================
#

CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gptfdisk=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y

#
# =========================================================
# Utilities
# =========================================================
#

CONFIG_PACKAGE_ddns-scripts-cloudflare=y
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_lsof=y
CONFIG_PACKAGE_mtr=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_sysstat=y
CONFIG_PACKAGE_tcpdump=y

CONFIG_PACKAGE_openssh-sftp-server=y

# 保留 curl / SSL 工具链
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_ca-certificates=y

#
# =========================================================
# LuCI Theme
# =========================================================
#

CONFIG_PACKAGE_luci-theme-argon=y

#
# =========================================================
# StrongSwan / IKEv2 / EAP-MSCHAPv2
# =========================================================
#

CONFIG_PACKAGE_strongswan=y
CONFIG_PACKAGE_strongswan-charon=y
CONFIG_PACKAGE_strongswan-swanctl=y
CONFIG_PACKAGE_strongswan-pki=y

#
# EAP
#
CONFIG_PACKAGE_strongswan-mod-eap-mschapv2=y
CONFIG_PACKAGE_strongswan-mod-eap-identity=y

#
# Crypto
#
CONFIG_PACKAGE_strongswan-mod-openssl=y
CONFIG_PACKAGE_strongswan-mod-aes=y
CONFIG_PACKAGE_strongswan-mod-sha1=y
CONFIG_PACKAGE_strongswan-mod-sha2=y
CONFIG_PACKAGE_strongswan-mod-hmac=y
CONFIG_PACKAGE_strongswan-mod-md4=y
CONFIG_PACKAGE_strongswan-mod-random=y

#
# Kernel / XFRM
#
CONFIG_PACKAGE_strongswan-mod-kernel-netlink=y
CONFIG_PACKAGE_strongswan-mod-socket-default=y

#
# Attributes / Policy
#
CONFIG_PACKAGE_strongswan-mod-attr=y
CONFIG_PACKAGE_strongswan-mod-constraints=y

#
# Certificate / Public Key
#
CONFIG_PACKAGE_strongswan-mod-pem=y
CONFIG_PACKAGE_strongswan-mod-pkcs1=y
CONFIG_PACKAGE_strongswan-mod-pkcs7=y
CONFIG_PACKAGE_strongswan-mod-x509=y
CONFIG_PACKAGE_strongswan-mod-pubkey=y

#
# VICI / swanctl
#
CONFIG_PACKAGE_strongswan-mod-vici=y

#
# DNS
#
CONFIG_PACKAGE_strongswan-mod-resolve=y

#
# =========================================================
# Linux IPsec / XFRM
# =========================================================
#

CONFIG_PACKAGE_kmod-ipsec=y
CONFIG_PACKAGE_kmod-ipsec4=y
CONFIG_PACKAGE_kmod-ipsec6=y
CONFIG_PACKAGE_kmod-xfrm-interface=y

#
# IPsec Crypto
#
CONFIG_PACKAGE_kmod-crypto-aead=y
CONFIG_PACKAGE_kmod-crypto-authenc=y
CONFIG_PACKAGE_kmod-crypto-cbc=y
CONFIG_PACKAGE_kmod-crypto-des=y
CONFIG_PACKAGE_kmod-crypto-hmac=y
CONFIG_PACKAGE_kmod-crypto-md5=y
CONFIG_PACKAGE_kmod-crypto-sha1=y

#
# =========================================================
# Explicitly disable obsolete / unnecessary XFRM split modules
# =========================================================
#

# CONFIG_PACKAGE_kmod-xfrm is not set
# CONFIG_PACKAGE_kmod-xfrm-state is not set
# CONFIG_PACKAGE_kmod-xfrm-policy is not set

#
# =========================================================
# Additional network / firewall modules
# =========================================================
#

CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-conntrack-netlink=y
CONFIG_PACKAGE_kmod-connmark=y

#
# =========================================================
# Disabled unnecessary applications
# =========================================================
#

# CONFIG_PACKAGE_luci-app-autoreboot is not set
# CONFIG_PACKAGE_luci-app-adbyby-plus is not set
# CONFIG_PACKAGE_luci-app-adguardhome is not set
# CONFIG_PACKAGE_luci-app-alist is not set
# CONFIG_PACKAGE_luci-app-arpbind is not set
# CONFIG_PACKAGE_luci-app-cifs-mount is not set
# CONFIG_PACKAGE_luci-app-dockerman is not set
# CONFIG_PACKAGE_luci-app-filetransfer is not set
# CONFIG_PACKAGE_luci-app-frpc is not set
# CONFIG_PACKAGE_luci-app-ipsec-vpnd is not set
# CONFIG_PACKAGE_luci-app-mosdns is not set
# CONFIG_PACKAGE_luci-app-netdata is not set
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_luci-app-ramfree is not set
# CONFIG_PACKAGE_luci-app-rclone is not set
# CONFIG_PACKAGE_luci-app-samba is not set
# CONFIG_PACKAGE_luci-app-smartdns is not set
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-turboacc is not set
# CONFIG_PACKAGE_luci-app-unblockmusic is not set
# CONFIG_PACKAGE_luci-app-upnp is not set
# CONFIG_PACKAGE_luci-app-vlmcsd is not set
# CONFIG_PACKAGE_luci-app-vsftpd is not set
# CONFIG_PACKAGE_luci-app-vssr is not set
# CONFIG_PACKAGE_luci-app-wrtbwmon is not set
# CONFIG_PACKAGE_luci-app-wireguard is not set
# CONFIG_PACKAGE_luci-app-xlnetacc is not set
# CONFIG_PACKAGE_luci-app-zerotier is not set

# CONFIG_PACKAGE_automount is not set
# CONFIG_PACKAGE_autosamba is not set
# CONFIG_PACKAGE_docker-compose is not set
# CONFIG_PACKAGE_nano-plus is not set
# CONFIG_PACKAGE_snmpd is not set

#
# Optional editor
#
# CONFIG_PACKAGE_vim-fuller is not set
